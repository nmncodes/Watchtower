# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.
# Copy this file to .env and fill in the required credentials

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL='postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require'
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET="generate-a-secure-random-string"
MONITOR_DOWN_ALERT_CONSECUTIVE_CHECKS=2

# NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Globalping Probing Configuration (Real 5-Continent Monitoring)
GLOBALPING_ENABLED=true
GLOBALPING_API_TOKEN=your-globalping-token-here
MONITOR_DISTRIBUTED_REGIONS="USA,Europe,India,Australia,Africa"

# Admin Designation
ADMIN_EMAIL=your-email@example.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

RESEND_API_KEY=your-resend-api-key
MONITOR_UPDATE_BATCH_SIZE=100
MONITOR_WRITE_ONLY_ON_CHANGE=true

# ─── BullMQ + Redis (Event-Driven Pipeline) ───
# Set QUEUE_ENABLED=true to use the async Redis queue instead of synchronous checks.
QUEUE_ENABLED=false
REDIS_URL=redis://localhost:6379
