# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL='postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require'
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET="generate-a-secure-random-string"
MONITOR_DOWN_ALERT_CONSECUTIVE_CHECKS=2

# NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

PROBE_US_EAST_1=https://your-probe-url-use1.workers.dev
PROBE_US_WEST_2=https://your-probe-url-usw2.workers.dev
PROBE_EU_WEST_1=https://your-probe-url-euw1.workers.dev
PROBE_AP_SOUTH_1=https://your-probe-url-aps1.workers.dev
PROBE_AP_SOUTHEAST_1=https://your-probe-url-apse1.workers.dev

MONITOR_DISTRIBUTED_REGIONS="us-east-1,us-west-2,eu-west-1,ap-south-1,ap-southeast-1"
# Set this only if you configured PROBE_AUTH_TOKEN in workers.
# MONITOR_REGION_PROBE_AUTH_TOKEN="replace-with-worker-probe-auth-token"
# Optional per-region overrides (takes precedence over MONITOR_REGION_PROBE_AUTH_TOKEN)
MONITOR_REGION_PROBE_AUTH_TOKENS='{"us-east-1":"token1","us-west-2":"token2","eu-west-1":"token3","ap-south-1":"token4","ap-southeast-1":"token5"}'
MONITOR_REGION_PROBE_ENDPOINTS='{"us-east-1":"https://.../probe","us-west-2":"https://.../probe","eu-west-1":"https://.../probe","ap-south-1":"https://.../probe","ap-southeast-1":"https://.../probe"}'

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

RESEND_API_KEY=your-resend-api-key
MONITOR_UPDATE_BATCH_SIZE=100
MONITOR_WRITE_ONLY_ON_CHANGE=true

# ─── BullMQ + Redis (Event-Driven Pipeline) ───
# Set QUEUE_ENABLED=true to use the async Redis queue instead of synchronous checks.
QUEUE_ENABLED=false
REDIS_URL=redis://localhost:6379
